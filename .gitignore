.ansible/
changelogs/.plugin-cache.yaml

# Ephemeral Molecule symlink created by CI/local runs (ln -sfn . molecule)
extensions/molecule/molecule

# Accidental local galaxy installs during molecule runs
extensions/molecule/**/collections/

# Bootstrap molecule generate outputs (playbook repo seed copy)
extensions/molecule/integration_bootstrap_*/playbooks/
extensions/molecule/integration_bootstrap_*/configs/
extensions/molecule/integration_bootstrap_*/group_vars/
extensions/molecule/integration_bootstrap_*/templates/
extensions/molecule/integration_bootstrap_*/terraform/
extensions/molecule/integration_bootstrap_*/ansible.cfg
extensions/molecule/integration_bootstrap_*/ado-preflight-*.json
!extensions/molecule/integration_bootstrap_*/ado-preflight-*.fixture.json

# Local collection install path (keeps collections/requirements.yml)
collections/ansible_collections/

# Python bytecode / caches from local test runs
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/
.ansible-tmp/
.kube/
.tox/

# Local collection build / importer artifacts (never commit)
infra-ado-*.tar.gz
collections/infra-ado-*.tar.gz
*.tar.gz
importer_result.json

# VSCode
.vscode/

# Local-only Cursor rules (lab context, cred pointers — never commit)
.cursor/rules/local/

# Local pip/user installs and container storage (never commit)
.local/
.cache/
.ansible/
.config/
.cursor
