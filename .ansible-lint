---
# Cert checker runs `ansible-lint --profile=production` without --offline.
# galaxy.yml depends on Hub-only transitive collections (ansible.platform via
# infra.aap_configuration). Without a Hub token those installs fail after a
# long retry. Existing CI already lints --offline with the mocks below.
offline: true

exclude_paths:
    - "**/.github/**"
    - .ansible-lint
    - "**/.ansible/**"
    - "**/.local/**"
    - "**/.cache/**"
    - "roles/**/defaults/**"  # explicit role defaults exclusion
    - "**/defaults/**"      # exclude any defaults dir anywhere
    - "**/vars/**"          # exclude any vars dir anywhere
    - "**/molecule/**"     # exclude any molecule dir anywhere
    - "**/meta/**"         # exclude any meta dir anywhere
    - "**/files/**"        # vendor/k8s manifests shipped with roles
    - "roles/**/meta/**"  # explicit role meta exclusion
    - galaxy.yml
    - "**/changelogs/**"
    - devfile.yaml
    - collections/requirements.yml

    - roles/bootstrap_controller/files/job_templates/**
    - roles/bootstrap_controller/files/job_templates.disabled/**
    - roles/bootstrap_controller/files/workflows/**
    - roles/bootstrap_generate_playbook_repo/files/playbooks/**
    - roles/bootstrap_generate_playbook_repo/files/playbook_repo_seed/**
    # ansible-core 2.18 production lint recurses on include_role vars that
    # pass through ``{{ varname }}`` or ``{{ varname | default(alias) }}``.
    - roles/bootstrap_controller/tasks/install_htpasswd.yml
    - roles/bootstrap_controller/tasks/install_iscsi_csi.yml

# mock_modules have no argument spec; args[module] would warn on every k8s/AH call
# and GitHub treats those as job annotations. Offline CI cannot load certified
# collections from Automation Hub.
skip_list:
    - args[module]
    # Cert checker uses --profile=production (ansible-core 2.18). Self-referential
    # include_role vars then raise unhandled Jinja exceptions instead of warnings.
    - jinja[invalid]

