{
  "uid": "ado-net-drops-{{ grafana_upload_alerts_datasource_slug }}",
  "title": "Network drops or errors on a node or pod ({{ grafana_upload_alerts_datasource_name }})",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "datasourceUid": "{{ grafana_upload_alerts_datasource_uid }}",
      "model": {
        "editorMode": "code",
        "expr": "(count((rate(node_network_receive_drop_total{device!~\"lo|veth.*\"}[5m]) + rate(node_network_transmit_drop_total{device!~\"lo|veth.*\"}[5m]) + rate(node_network_receive_errs_total{device!~\"lo|veth.*\"}[5m]) + rate(node_network_transmit_errs_total{device!~\"lo|veth.*\"}[5m])) > 5) or vector(0)) + (count((rate(container_network_receive_packets_dropped_total{pod!=\"\"}[5m]) + rate(container_network_transmit_packets_dropped_total{pod!=\"\"}[5m])) > 5) or vector(0))",
        "instant": true,
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "datasourceUid": "__expr__",
      "model": {
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "queryType": "",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "datasourceUid": "__expr__",
      "model": {
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "expression": "B",
        "refId": "C",
        "type": "threshold",
        "conditions": [
          {
            "evaluator": {
              "params": [
                0
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "C"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "10m",
  "annotations": {
    "summary": "A node or pod is dropping or erroring packets. Default metrics do not include round-trip latency."
  },
  "labels": {
    "ado": "openshift-default",
    "cluster": "{{ grafana_upload_alerts_datasource_name }}"
  },
  "folderUID": "{{ grafana_upload_alerts_folder_uid }}",
  "ruleGroup": "openshift-{{ grafana_upload_alerts_datasource_slug }}",
  "orgID": 1
}
