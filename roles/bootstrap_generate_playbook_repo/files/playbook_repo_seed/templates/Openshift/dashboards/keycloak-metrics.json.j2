        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(process_cpu_usage{namespace=~\"$namespace\", pod=~\"$pod\"}) or max(process_cpu_usage{exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", namespace=~\"$namespace\", pod=~\"$pod\"}) or sum(jvm_memory_used_bytes{area=\"heap\", exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Non-heap used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\", namespace=~\"$namespace\", pod=~\"$pod\"}) or sum(jvm_memory_used_bytes{area=\"nonheap\", exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM memory used (heap / non-heap)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (area) (jvm_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"}) or sum by (area) (jvm_memory_used_bytes{exported_namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{area}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP server request rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) or sum(rate(http_server_requests_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "all requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", status=~\"5..\"}[5m])) or sum(rate(http_server_requests_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\", status=~\"4..\"}[5m])) or sum(rate(http_server_requests_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\", status=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request duration (p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))) or histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{exported_namespace=~\"$namespace\", pod=~\"$pod\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pause rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_count{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) or sum(rate(jvm_gc_pause_seconds_count{exported_namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "GC pauses/s",
          "refId": "A"
        }
      ]

    },
    {
      "type": "row",
      "title": "Login events (user-event metrics)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Login success (total)",
      "description": "event=login with empty error",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\"}) - sum(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\", error=~\".+\"})) or (sum(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\"}) - sum(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\", error=~\".+\"})) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Login failures (total)",
      "description": "event=login with non-empty error",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\", error=~\".+\"}) or sum(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\", error=~\".+\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Login success vs failure rate",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\"}[5m])) - sum(rate(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\", error=~\".+\"}[5m]))) or (sum(rate(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\"}[5m])) - sum(rate(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\", error=~\".+\"}[5m])))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\", error=~\".+\"}[5m])) or sum(rate(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\", error=~\".+\"}[5m]))",
          "legendFormat": "failure",
          "refId": "B"
        }
      ]
    },
    {
      "type": "table",
      "title": "Failed logins by reason",
      "description": "Native keycloak_user_events_total (no username). See panel below for who failed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "mappings": [
            {
              "options": {
                "invalid_user_credentials": {
                  "text": "Bad password",
                  "index": 0
                },
                "user_not_found": {
                  "text": "Unknown user",
                  "index": 1
                },
                "user_disabled": {
                  "text": "User disabled",
                  "index": 2
                },
                "user_temporarily_disabled": {
                  "text": "Temporarily disabled",
                  "index": 3
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Fail reason"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Count"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "exported_namespace": true,
              "pod": true,
              "container": true,
              "endpoint": true,
              "service": true,
              "prometheus": true,
              "prometheus_replica": true,
              "event": true,
              "idp": true
            },
            "renameByName": {
              "error": "Fail reason",
              "Value": "Count"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "sum by (error, realm, client_id) (keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\", error=~\".+\"}) or sum by (error, realm, client_id) (keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\", error=~\".+\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed login rate by reason",
      "description": "Stacked by Keycloak error (bad password / unknown user / …)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (error) (rate(keycloak_user_events_total{namespace=~\"$namespace\", event=\"login\", error=~\".+\"}[5m])) or sum by (error) (rate(keycloak_user_events_total{exported_namespace=~\"$namespace\", event=\"login\", error=~\".+\"}[5m]))",
          "legendFormat": "{{error}}",
          "refId": "A"
        }
      ]

    },
    {
      "type": "table",
      "title": "Failed logins by username",
      "description": "From Admin event store via keycloak-login-events exporter. Sorted by newest failure. Requires realm eventsEnabled + exporter deploy.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "mappings": [
            {
              "options": {
                "invalid_user_credentials": {
                  "text": "Bad password",
                  "index": 0
                },
                "user_not_found": {
                  "text": "Unknown user",
                  "index": 1
                },
                "user_disabled": {
                  "text": "User disabled",
                  "index": 2
                },
                "user_temporarily_disabled": {
                  "text": "Temporarily disabled",
                  "index": 3
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Last seen",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "pod": true,
              "container": true,
              "endpoint": true,
              "service": true,
              "prometheus": true,
              "prometheus_replica": true
            },
            "renameByName": {
              "username": "Username",
              "error": "Fail reason",
              "client_id": "client_id",
              "realm": "realm",
              "ip": "IP",
              "Value #Count": "Count",
              "Value #Last": "Last seen",
              "Value": "Count"
            },
            "indexByName": {
              "Last seen": 0,
              "Username": 1,
              "Fail reason": 2,
              "client_id": 3,
              "realm": 4,
              "IP": 5,
              "Count": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Last seen",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "expr": "sum by (username, error, client_id, realm, ip) (keycloak_login_failure_events)",
          "format": "table",
          "instant": true,
          "refId": "Count"
        },
        {
          "expr": "max by (username, error, client_id, realm, ip) (keycloak_login_failure_last_timestamp)",
          "format": "table",
          "instant": true,
          "refId": "Last"
        }
      ]
    }
