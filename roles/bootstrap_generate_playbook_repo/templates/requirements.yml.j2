---
# Controller project sync installs from Hub/Galaxy — no vendored collection trees in git.
# Do not pin versions here. Contoller must take whatever Hub has for each name.
collections:
{% for item in bootstrap_generate_playbook_repo_hub_requirements | default([]) %}
  - name: {{ item.name }}
{% endfor %}
{% for item in bootstrap_generate_playbook_repo_hub_requirements_galaxy_only | default([]) %}
  - name: {{ item.name }}
{% endfor %}
