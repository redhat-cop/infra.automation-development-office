[defaults]
inventory = localhost,
roles_path = ./roles
collections_paths = /workspace/collections:./collections:~/.ansible/collections:/usr/share/ansible/collections
host_key_checking = False
retry_files_enabled = False
# Use ansible.builtin.default — community.general.yaml was removed in
# community.general 12+ and breaks bootstrap on ansible-core 2.15+.
stdout_callback = default
interpreter_python = auto_silent

[privilege_escalation]
become = False

[galaxy]
ignore_certs = {{ (bootstrap_generate_playbook_repo_galaxy_ignore_certs | default(generate_playbook_repo_galaxy_ignore_certs | default(ansible_dispatch_ignore_galaxy_cert | default(false))) | bool) | ternary('True', 'False') }}
