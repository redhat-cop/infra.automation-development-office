{% set preflight_satellite_options =
    (
      bootstrap_generate_env_vars_preflight.component_options.satellite
      | default([])
      | map('lower')
      | list
    )
    if bootstrap_generate_env_vars_preflight is defined else []
%}
{% set satellite_server_inventory_selected =
    satellite_component_selected
    and (
      preflight_satellite_options | length == 0
      or 'satellite_server_install' in preflight_satellite_options
      or 'satellite_capsule_install' in preflight_satellite_options
      or 'satellite_oidc' in preflight_satellite_options
    )
%}
{% if satellite_server_inventory_selected and bootstrap_generate_env_vars_satellite_inventory_host | length > 0 %}
  - name: "{{ bootstrap_generate_env_vars_satellite_inventory_host }}"
    inventory: "{{ bootstrap_generate_env_vars_satellite_inventory }}"
    description: "Satellite host"
    enabled: true
    variables: {}
{% endif %}
{% set preflight_idm_options =
    (
      bootstrap_generate_env_vars_preflight.component_options.idm
      | default([])
      | map('lower')
      | list
    )
    if bootstrap_generate_env_vars_preflight is defined else []
%}
{% set idm_server_inventory_selected =
    idm_component_selected
    and (
      preflight_idm_options | length == 0
      or 'idm_server_install' in preflight_idm_options
      or 'idm_replica_install' in preflight_idm_options
      or 'idm_ad_trust_install' in preflight_idm_options
    )
%}
{% if idm_server_inventory_selected and bootstrap_generate_env_vars_idm_hostname | length > 0 %}
  - name: "{{ bootstrap_generate_env_vars_idm_hostname }}"
    inventory: "{{ bootstrap_generate_env_vars_idm_inventory }}"
    description: "IDM host"
    enabled: true
    variables: {}
{% endif %}
{% if idm_server_inventory_selected and bootstrap_generate_env_vars_idm_replica_hostname | length > 0 %}
  - name: "{{ bootstrap_generate_env_vars_idm_replica_hostname }}"
    inventory: "{{ bootstrap_generate_env_vars_idm_inventory }}"
    description: "IDM replica host"
    enabled: true
    variables: {}
{% endif %}{% if openshift_component_selected and bootstrap_generate_env_vars_openshift_api_host | length > 0 %}
  - name: "{{ bootstrap_generate_env_vars_openshift_api_host }}"
    inventory: "{{ bootstrap_generate_env_vars_aap_inventory }}"
    description: "OpenShift API endpoint"
    enabled: true
    variables:
      ansible_connection: local
{% endif %}

controller_bootstrap_controller_inventory_sources:
{% if bootstrap_generate_env_vars_satellite_dynamic_inventory_enabled %}
  - name: "{{ bootstrap_generate_env_vars_satellite_inventory_source_name }}"
    description: "Satellite 6 dynamic inventory source"
    inventory: "{{ bootstrap_generate_env_vars_rhel_inventory }}"
    organization: "{{ bootstrap_generate_env_vars_aap_org }}"
    source: satellite6
    credential: "{{ bootstrap_generate_env_vars_satellite_credential_name }}"
    overwrite: {{ bootstrap_generate_env_vars_satellite_inventory_overwrite | lower }}
    overwrite_vars: {{ bootstrap_generate_env_vars_satellite_inventory_overwrite_vars | lower }}
    update_on_launch: {{ bootstrap_generate_env_vars_satellite_inventory_update_on_launch | lower }}
    update_cache_timeout: {{ bootstrap_generate_env_vars_satellite_inventory_update_cache_timeout }}
    verbosity: {{ bootstrap_generate_env_vars_satellite_inventory_verbosity }}
{% if bootstrap_generate_env_vars_satellite_inventory_host_filter | length > 0 %}
    host_filter: "{{ bootstrap_generate_env_vars_satellite_inventory_host_filter }}"
{% endif %}
{% if bootstrap_generate_env_vars_satellite_inventory_effective_source_vars | length > 0 %}
    source_vars:
{{ bootstrap_generate_env_vars_satellite_inventory_effective_source_vars | to_nice_yaml(indent=2) | indent(6, true) }}
{% endif %}
{% else %}
  []
{% endif %}

controller_bootstrap_controller_execution_environments:
  - name: "{{ bootstrap_generate_env_vars_aap_ee }}"
    image: "{{ bootstrap_generate_env_vars_aap_ee_image }}"
    pull: missing
    organization: "{{ bootstrap_generate_env_vars_aap_org }}"

controller_bootstrap_controller_labels:
  - name: "{{ bootstrap_generate_env_vars_aap_org }}"
    organization: "{{ bootstrap_generate_env_vars_aap_org }}"


bootstrap_generate_env_vars_force: "{{ bootstrap_generate_env_vars_git_override_group_vars_env | bool }}"
generate_env_vars_force: "{{ bootstrap_generate_env_vars_git_override_group_vars_env | bool }}"
bootstrap_generate_playbook_repo_force: "{{ bootstrap_generate_env_vars_git_override_all | bool }}"
bootstrap_controller_generate_aap_configs_force_job_workflows: "{{ bootstrap_generate_env_vars_git_override_jt_wf | bool }}"

generate_playbook_repo_git_mode: "{{ 'push' if bootstrap_generate_env_vars_git_auto_push else 'manual' }}"
generate_playbook_repo_git_push: "{{ bootstrap_generate_env_vars_git_auto_push }}"
generate_playbook_repo_git_commit: "{{ bootstrap_generate_env_vars_git_auto_push }}"
generate_playbook_repo_pause_for_push: "{{ not bootstrap_generate_env_vars_git_auto_push }}"
generate_playbook_repo_git_url: "{{ bootstrap_generate_env_vars_aap_git_url }}"
generate_playbook_repo_git_branch: "{{ bootstrap_generate_env_vars_aap_git_branch }}"
generate_playbook_repo_git_remote: "origin"
generate_playbook_repo_git_sync_before_push: true
generate_playbook_repo_git_username: "{{ bootstrap_generate_env_vars_git_scm_username }}"
generate_playbook_repo_git_token: "{% raw %}{{ vault_controller_git_token }}{% endraw %}"
generate_playbook_repo_git_auth_mode: "{{ 'bearer' if (bootstrap_generate_env_vars_preflight.scm_tool | default('gitlab') | lower) == 'bitbucket' else 'basic' }}"
