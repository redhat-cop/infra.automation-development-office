    description: "{{ bootstrap_generate_env_vars_aap_org }}"
{# Org Galaxy attach only when Galaxy setup is explicitly enabled and a Hub token
   is present — hub-only collection publish must not push lab creds. #}
{% for galaxy_credential in preflight_galaxy_credentials_ordered
   if preflight_galaxy_setup_enabled
   and preflight_galaxy_hub_token_present
   and (galaxy_credential.attach_to_org | default(true) | bool)
   and (galaxy_credential.name | default('', true) | length > 0) %}
{% if loop.first %}
    galaxy_credentials:
{% endif %}
      - "{{ galaxy_credential.name }}"
{% endfor %}
{% set preflight_onboard_tenants = preflight_aap.onboard.tenants | default([]) %}
{% for onboard_tenant in preflight_onboard_tenants %}
{% if (onboard_tenant.enabled | default(true) | bool) and (onboard_tenant.create_organization | default(true) | bool) and (onboard_tenant.organization | default('', true) | length > 0) and (onboard_tenant.organization != bootstrap_generate_env_vars_aap_org) %}
  - name: "{{ onboard_tenant.organization }}"
    description: "{{ onboard_tenant.description | default(onboard_tenant.organization, true) }}"
{% endif %}
{% endfor %}

{# Optional non-admin Contoller user from Galaxy tab (separate from General admin). #}
