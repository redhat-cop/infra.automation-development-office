vault_satellite_service_account_password: "{{ bootstrap_generate_env_vars_satellite_service_account_password | default('') }}"
vault_satellite_admin_password: "{{ bootstrap_generate_env_vars_satellite_admin_password | default(bootstrap_generate_env_vars_satellite_service_account_password | default('')) }}"
vault_satellite_rhn_org_id: "{{ bootstrap_generate_env_vars_satellite_rhn_org_id | default('') }}"
vault_satellite_rhn_activation_key: "{{ bootstrap_generate_env_vars_satellite_rhn_activation_key | default('') }}"
vault_satellite_oidc_client_secret: "{{ bootstrap_generate_env_vars_satellite_oidc_client_secret | default('') }}"
vault_rhbk_admin_user: "{{ bootstrap_generate_env_vars_satellite_oidc_admin_user | default('admin') }}"
vault_rhbk_admin_password: "{{ bootstrap_generate_env_vars_satellite_oidc_admin_password | default('redhat123') }}"
satellite_install_admin_password: "{% raw %}{{ vault_satellite_admin_password }}{% endraw %}"
satellite_install_rhn_org_id: "{% raw %}{{ vault_satellite_rhn_org_id }}{% endraw %}"
satellite_install_rhn_activation_key: "{% raw %}{{ vault_satellite_rhn_activation_key }}{% endraw %}"
vault_capsule_activation_key: "{{ bootstrap_generate_env_vars_capsule_activation_key | default('') }}"
vault_capsule_loadbalancer_activation_key: "{{ bootstrap_generate_env_vars_capsule_loadbalancer_activation_key | default('') }}"
capsule_install_admin_password: "{% raw %}{{ vault_satellite_admin_password }}{% endraw %}"
capsule_install_activation_key: "{% raw %}{{ vault_capsule_activation_key }}{% endraw %}"
capsule_install_loadbalancer_activation_key: "{% raw %}{{ vault_capsule_loadbalancer_activation_key }}{% endraw %}"
satellite_oidc_client_secret: "{% raw %}{{ vault_satellite_oidc_client_secret | default('') }}{% endraw %}"
satellite_oidc_admin_user: "{% raw %}{{ vault_rhbk_admin_user | default('admin') }}{% endraw %}"
satellite_oidc_admin_password: "{% raw %}{{ vault_rhbk_admin_password | default('redhat123') }}{% endraw %}"
rhbk_admin_user: "{% raw %}{{ vault_rhbk_admin_user | default('admin') }}{% endraw %}"
rhbk_admin_password: "{% raw %}{{ vault_rhbk_admin_password | default('redhat123') }}{% endraw %}"

{% elif component_name == 'idm' %}
vault_idm_admin_password: ""
vault_idm_directory_manager_password: ""
vault_ad_trust_admin_password: ""
ipaadmin_password: "{% raw %}{{ vault_idm_admin_password }}{% endraw %}"
idm_server_ipaadmin_password: "{% raw %}{{ vault_idm_admin_password }}{% endraw %}"
idm_configure_replica_admin_password: "{% raw %}{{ vault_idm_admin_password }}{% endraw %}"
idm_configure_replica_dm_password: "{% raw %}{{ vault_idm_directory_manager_password }}{% endraw %}"
idm_ad_trust_ipa_admin_password: "{% raw %}{{ vault_idm_admin_password }}{% endraw %}"
idm_ad_trust_ad_admin_password: "{% raw %}{{ vault_ad_trust_admin_password }}{% endraw %}"

{% elif component_name == 'htpasswd' or component_name == 'htpass_admin' or component_name == 'admin_htpasswd' %}
# Populated by overlay from preflight openshift.htpasswd_users — no silent defaults.
htpasswd_users: []
htpasswd_pass: ""

{% elif component_name == 'cert_manager' %}
tls_crt:
tls_key:

{% elif component_name == 'aws' %}
vault_aws_access_key_id: ""
vault_aws_secret_access_key: ""
vault_aws_session_token: ""

{% elif component_name == 'terraform' %}
vault_terraform_cloud_token: ""
vault_terraform_http_username: ""
vault_terraform_http_password: ""

{% elif component_name == 'openshift' %}
# HTPasswd users come from preflight overlay (openshift.htpasswd_users) — no silent defaults.
htpasswd_users: []
htpasswd_pass: ""

{% elif component_name == 'openshift_virt' %}
{% set openshift_virt_config = bootstrap_generate_env_vars_preflight.component_config.openshift_virt | default({}) if bootstrap_generate_env_vars_preflight is defined else {} %}
provision_openshift_virt_api_token: "{{ openshift_virt_config.api_token | default(bootstrap_generate_env_vars_openshift_virt_api_token | default(''), true) }}"

{% elif component_name == 'gitlab' %}
gitlab_tls_crt:
gitlab_tls_key:
gitlab_root_user: root
gitlab_root_password: redhat123

{% elif component_name == 'rhbk' %}
rhbk_tls_cert:
rhbk_tls_key:
rhbk_admin_user: admin
rhbk_admin_password: redhat123
ocp_rhbk_admin_user: admin
ocp_rhbk_admin_password: redhat123

ldap_config:
  enabled: "true"
  vendor: rhds
  connectionUrl: ldap://idm.server.lab
  bindDn: "cn=Directory Manager"
  bindCredential: knuckle01
  usersDn: "cn=users,cn=accounts,dc=server,dc=lab"
  authType: simple
  useTruststoreSpi: ldapsOnly
  editMode: READ_ONLY
  syncRegistrations: "false"
  priority: "0"
  cachePolicy: DEFAULT
  usernameLDAPAttribute: uid
  rdnLDAPAttribute: uid
  uuidLDAPAttribute: nsuniqueid
  userObjectClasses: inetOrgPerson

ldap_group_config:
  # Keycloak Component API requires MultivaluedHashMap: each value is a list.
  groups.dn:
    - "cn=groups,cn=accounts,dc=server,dc=lab"
  group.name.ldap.attribute:
    - cn
  group.object.classes:
    - groupOfNames
  preserve.group.inheritance:
    - "true"
  ignore.missing.groups:
    - "false"
  membership.ldap.attribute:
    - member
  membership.attribute.type:
    - DN
  membership.user.ldap.attribute:
    - dn
  mode:
    - READ_ONLY
  user.roles.retrieve.strategy:
    - LOAD_GROUPS_BY_MEMBER_ATTRIBUTE

# IdM user-attribute LDAP mappers (match prod rhlab federation).
ldap_user_mappers:
  - name: username
    config:
      ldap.attribute: uid
      user.model.attribute: username
      read.only: "true"
      is.mandatory.in.ldap: "false"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: email
    config:
      ldap.attribute: mail
      user.model.attribute: email
      read.only: "false"
      is.mandatory.in.ldap: "false"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: display name
    config:
      ldap.attribute: displayname
      user.model.attribute: firstName
      read.only: "false"
      is.mandatory.in.ldap: "true"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: common name
    config:
      ldap.attribute: cn
      user.model.attribute: username
      read.only: "false"
      is.mandatory.in.ldap: "true"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: legalname
    config:
      ldap.attribute: legalname
      user.model.attribute: lastName
      read.only: "false"
      is.mandatory.in.ldap: "false"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: gid
    config:
      ldap.attribute: gidnumber
      user.model.attribute: ldap_gid
      read.only: "false"
      is.mandatory.in.ldap: "true"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: uid
    config:
      ldap.attribute: uidnumber
      user.model.attribute: ldap_uid
      read.only: "false"
      is.mandatory.in.ldap: "true"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: homedirectory
    config:
      ldap.attribute: homedirectory
      user.model.attribute: ldap_homedir
      read.only: "false"
      is.mandatory.in.ldap: "true"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "false"
  - name: creation date
    config:
      ldap.attribute: createtimestamp
      user.model.attribute: createtimestamp
      read.only: "true"
      is.mandatory.in.ldap: "false"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "true"
  - name: modify date
    config:
      ldap.attribute: modifytimestamp
      user.model.attribute: modifytimestamp
      read.only: "true"
      is.mandatory.in.ldap: "false"
      attribute.force.default: "true"
      is.binary.attribute: "false"
      always.read.value.from.ldap: "true"

{% elif component_name == 'dev_hub' %}
dev_hub_backend_secret: changeme-backend-secret
dev_hub_oidc_client_secret: ""
dev_hub_gitlab_token: ""

