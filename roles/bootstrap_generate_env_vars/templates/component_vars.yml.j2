{% if virt_dns is string %}
provision_openshift_virt_dns_servers: {{ virt_dns | to_json }}
{% else %}
provision_openshift_virt_dns_servers: {{ virt_dns | to_json }}
{% endif %}
openshift_virt_ip_range: {{ openshift_virt_config.ip_range | default(bootstrap_generate_env_vars_openshift_virt_ip_range | default('', true), true) | to_json }}
