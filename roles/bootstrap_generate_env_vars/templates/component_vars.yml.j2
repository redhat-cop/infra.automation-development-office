---
# Generated by infra.ado.bootstrap_generate_env_vars
# Component: {{ component_name }}

{% if component_name == 'aap' %}
{% set aap_cfg = bootstrap_generate_env_vars_preflight.component_config.aap | default({}) if bootstrap_generate_env_vars_preflight is defined else {} %}
{% set aap_minimal = aap_cfg.minimal_footprint | default(false) | bool %}
{% set aap_scope_raw = (aap_cfg.operator_scope | default('all_namespaces') | string | lower | replace('-', '_')) %}
{% if aap_scope_raw in ['namespaced', 'namespace', 'single_namespace'] %}
{% set aap_operator_channel = aap_cfg.operator_channel | default('stable-' ~ bootstrap_generate_env_vars_aap_deployment_version) %}
{% else %}
{% set aap_operator_channel = aap_cfg.operator_channel | default('stable-' ~ bootstrap_generate_env_vars_aap_deployment_version ~ '-cluster-scoped') %}
{% endif %}
aap_ocp_install_namespace: "{{ bootstrap_generate_env_vars_aap_namespace }}"
aap_ocp_install_create_namespace: {{ bootstrap_generate_env_vars_aap_create_namespace | bool | lower }}
aap_ocp_install_connection:
  host: "{% raw %}{{ host }}{% endraw %}"
  api_key: "{% raw %}{{ token }}{% endraw %}"
  validate_certs: "{% raw %}{{ verify_ssl | default(false) | bool }}{% endraw %}"
aap_operator_scope: "{{ 'namespaced' if aap_scope_raw in ['namespaced', 'namespace', 'single_namespace'] else 'all_namespaces' }}"
aap_ocp_install_operator:
  channel: "{{ aap_operator_channel }}"
  approval: automatic
aap_ocp_install_platform:
  instance_name: "{{ bootstrap_generate_env_vars_aap_instance_name }}"
  namespace: "{{ bootstrap_generate_env_vars_aap_namespace }}"
  component_deployment: "{{ bootstrap_generate_env_vars_aap_component_deployment }}"
  admin_user: "{% raw %}{{ aap_admin_user | default('admin') }}{% endraw %}"
  admin_password_secret: "{{ bootstrap_generate_env_vars_aap_instance_name }}-admin-password"
aap_ocp_install_controller:
  instance_name: "{{ bootstrap_generate_env_vars_aap_instance_name }}-controller"
  namespace: "{{ bootstrap_generate_env_vars_aap_namespace }}"
  install: {{ bootstrap_generate_env_vars_aap_install_controller | bool | lower }}
  admin_user: "{% raw %}{{ aap_admin_user | default('admin') }}{% endraw %}"
  replicas: {{ aap_cfg.replicas | default(aap_cfg.controller_replicas | default(bootstrap_generate_env_vars_aap_controller_replicas)) | int }}
aap_ocp_install_hub:
  instance_name: "{{ bootstrap_generate_env_vars_aap_instance_name }}-hub"
  namespace: "{{ bootstrap_generate_env_vars_aap_namespace }}"
  install: {{ (false if aap_minimal else bootstrap_generate_env_vars_aap_install_hub) | bool | lower }}
  storage_type: "{{ bootstrap_generate_env_vars_aap_hub_storage_type }}"
  file_storage_storage_class: "{{ bootstrap_generate_env_vars_aap_hub_storage_class }}"
  file_storage_size: "{{ bootstrap_generate_env_vars_aap_hub_storage_size }}"
  object_storage_s3_secret: "{{ bootstrap_generate_env_vars_aap_hub_s3_secret }}"
  object_storage_azure_secret: "{{ bootstrap_generate_env_vars_aap_hub_azure_secret }}"
aap_ocp_install_eda:
  instance_name: "{{ bootstrap_generate_env_vars_aap_instance_name }}-eda"
  namespace: "{{ bootstrap_generate_env_vars_aap_namespace }}"
  install: {{ (false if aap_minimal else bootstrap_generate_env_vars_aap_install_eda) | bool | lower }}
aap_ocp_install_lightspeed:
  install: {{ (false if aap_minimal else bootstrap_generate_env_vars_aap_install_lightspeed) | bool | lower }}
aap_install_during_bootstrap: {{ aap_cfg.install_during_bootstrap | default(false) | bool | lower }}
aap_minimal_footprint: {{ aap_minimal | bool | lower }}
{% set pre_aap = (bootstrap_generate_env_vars_preflight.pre_installs.aap | default({})) if bootstrap_generate_env_vars_preflight is defined else {} %}
aap_ocp_install_license_mode: "{{ aap_cfg.license_mode | default(pre_aap.license_mode | default('none')) }}"
aap_ocp_install_license_only: {{ aap_cfg.license_only | default(pre_aap.license_only | default(false)) | bool | lower }}
aap_ocp_install_subscription_manifest_filename: "{{ aap_cfg.subscription_manifest_file | default(pre_aap.subscription_manifest_file | default('manifest.zip')) }}"
aap_ocp_install_rhn_username: "{{ aap_cfg.rhn_username | default(pre_aap.rhn_username | default('')) }}"

{% elif component_name == 'aap24' %}
components_env:
  aap24:
    projects_persistence: true
    projects_storage_class: synology-nfs-csi
    projects_storage_size: 8Gi
    projects_storage_access_mode: ReadWriteMany
    cert_issuer_kind: ClusterIssuer
    cert_issuer_name: idm-acme
    controller_tls_secret: controller24-route-tls
    aap24_activate_subscription: false
    aap24_subscription_method: manifest
    aap24_subscription_manifest_path: ""

{% elif component_name == '389ds' %}
components_env:
  389ds:
    storage_class_name: synology-nfs-csi
    expected_replicas: 2
    enable_certificate: false
    dirsrv_cleanup: true
    enable_bootstrap_templates: true

{% elif component_name == 'gitlab' %}
components_env:
  gitlab:
    storage_class: synology-nfs-csi
    storage: synology-nfs-csi

{% elif component_name == 'grafana' %}
components_env:
  grafana:
    operator_channel: "5.20.0"
    operator_starting_csv: ""
    grafana_folder: OpenshiftProd
    storage: synology-nfs-csi
    oidc:
      enabled: true
      client_id: grafana_client
      scopes:
        - openid
        - profile
        - email
        - groups
      default_role: Viewer
      role_map:
        - group: ocp-cluster-admin
          role: GrafanaAdmin
        - group: ocp-cluster-devel
          role: Viewer
        - group: ocp-cluster-ops
          role: Editor
        - group: ocp-cluster-readonly
          role: Viewer

{% elif component_name == 'kafka' %}
components_env:
  kafka:
    operator_channel: "2.11"
    operator_starting_csv: ""

{% elif component_name == 'satellite' %}
satellite_config_server_url: "{{ bootstrap_generate_env_vars_satellite_server_url | default('') }}"
{% if bootstrap_generate_env_vars_satellite_service_account_username is defined %}
satellite_config_username: "{{ bootstrap_generate_env_vars_satellite_service_account_username }}"
{% else %}
satellite_config_username: "{% raw %}{{ vault_satellite_service_account_username | default(omit) }}{% endraw %}"
{% endif %}
satellite_config_password: "{% raw %}{{ vault_satellite_service_account_password | default(omit) }}{% endraw %}"
satellite_config_admin_password: "{% raw %}{{ vault_satellite_admin_password | default(vault_satellite_service_account_password | default(omit)) }}{% endraw %}"
satellite_config_organization: "{{ bootstrap_generate_env_vars_satellite_organization | default('') }}"
satellite_config_validate_certs: {{ bootstrap_generate_env_vars_satellite_validate_certs | default(false) | bool | lower }}
satellite_config_rhn_connected: {{ bootstrap_generate_env_vars_satellite_rhn_connected | default(true) | bool | lower }}
satellite_config_satellite_deployment_version: "{{ bootstrap_generate_env_vars_satellite_deployment_version | default('6.19', true) }}"
satellite_install_deployment_version: "{{ bootstrap_generate_env_vars_satellite_deployment_version | default('6.19', true) }}"
satellite_install_location: "{{ bootstrap_generate_env_vars_satellite_location | default('') }}"
satellite_install_rhn_connected: {{ ((bootstrap_generate_env_vars_satellite_rhn_org_id | default('') | length) > 0 and (bootstrap_generate_env_vars_satellite_rhn_activation_key | default('') | length) > 0) | bool | lower }}
{% if bootstrap_generate_env_vars_satellite_manifest_file | default('') | length > 0 %}
satellite_config_manifest_file: "{{ bootstrap_generate_env_vars_satellite_manifest_file }}"
satellite_config_manifest_src: "{% raw %}{{ playbook_dir }}/../../files/{% endraw %}{{ bootstrap_generate_env_vars_satellite_manifest_file }}"
satellite_config_manifest_path: "/root/{{ bootstrap_generate_env_vars_satellite_manifest_file }}"
satellite_config_upload_manifest: true
{% endif %}
satellite_install_rhn_org_id: "{% raw %}{{ vault_satellite_rhn_org_id | default(omit) }}{% endraw %}"
satellite_install_rhn_activation_key: "{% raw %}{{ vault_satellite_rhn_activation_key | default(omit) }}{% endraw %}"
satellite_install_size_profile: "{{ bootstrap_generate_env_vars_satellite_size_profile | default('default') }}"
satellite_install_size:
{{ bootstrap_generate_env_vars_satellite_size | to_nice_yaml(indent=2) | indent(2, true) }}
{% set selected_satellite_size = (bootstrap_generate_env_vars_satellite_size | default([]) | selectattr('name', 'equalto', bootstrap_generate_env_vars_satellite_size_profile | default('default')) | first | default({})) %}
satellite_install_min_memory_size: {{ (selected_satellite_size.min_ram | default(20) | int) * 1024 }}
satellite_install_min_cpu_count: {{ selected_satellite_size.min_cpu | default(4) | int }}
satellite_install_vg_name: "{{ bootstrap_generate_env_vars_satellite_vg_name | default('satellite', true) }}"
satellite_install_req_dirs:
{{ bootstrap_generate_env_vars_satellite_req_dirs | to_nice_yaml(indent=2) | indent(2, true) }}
satellite_install_data_disk_min_size: "{{ bootstrap_generate_env_vars_satellite_data_disk_min_size | default('10G', true) }}"
satellite_install_data_device_name: "{{ bootstrap_generate_env_vars_satellite_data_device_name | default('', true) }}"
satellite_install_data_device: "{{ bootstrap_generate_env_vars_satellite_data_device | default('/dev', true) }}"
capsule_install_deployment_version: "{{ bootstrap_generate_env_vars_capsule_deployment_version | default(bootstrap_generate_env_vars_satellite_deployment_version | default('6.19', true), true) }}"
capsule_install_location: "{{ bootstrap_generate_env_vars_capsule_location | default(bootstrap_generate_env_vars_satellite_location | default(''), true) }}"
capsule_install_org_id: "{{ bootstrap_generate_env_vars_capsule_org_id | default(bootstrap_generate_env_vars_satellite_organization | default(''), true) }}"
capsule_install_satellite_fqdn: >-
  {{
    bootstrap_generate_env_vars_capsule_satellite_fqdn | default('', true)
    if (bootstrap_generate_env_vars_capsule_satellite_fqdn | default('', true) | length) > 0
    else (
      bootstrap_generate_env_vars_satellite_server_url | default('')
      | regex_replace('^https?://', '')
      | regex_replace('/.*$', '')
    )
  }}
capsule_install_min_memory_size: {{ bootstrap_generate_env_vars_capsule_min_memory_size | default(12288) | int }}
capsule_install_min_cpu_count: {{ bootstrap_generate_env_vars_capsule_min_cpu_count | default(4) | int }}
capsule_install_min_pulp_size: {{ bootstrap_generate_env_vars_capsule_min_pulp_size | default(300) | int }}
capsule_install_min_pgsql_size: {{ bootstrap_generate_env_vars_capsule_min_pgsql_size | default(20) | int }}
capsule_install_data_disk_min_size: {{ bootstrap_generate_env_vars_capsule_data_disk_min_size | default(500) | int }}
capsule_install_pulp_size: "{{ bootstrap_generate_env_vars_capsule_pulp_size | default('1500g', true) }}"
capsule_install_pgsql_size: "{{ bootstrap_generate_env_vars_capsule_pgsql_size | default('150g', true) }}"
capsule_install_data_device: "{{ bootstrap_generate_env_vars_capsule_data_device | default('/dev', true) }}"
capsule_install_data_device_name: "{{ bootstrap_generate_env_vars_capsule_data_device_name | default('', true) }}"
capsule_install_vg_name: "{{ bootstrap_generate_env_vars_capsule_vg_name | default('capsule', true) }}"
capsule_install_req_dirs:
  - mount_point: /var/lib/pulp
    lv_name: pulp
    lv_size: "{{ capsule_install_pulp_size }}"
  - mount_point: /var/lib/pgsql
    lv_name: pgsql
    lv_size: "{{ capsule_install_pgsql_size }}"
capsule_install_lifecycle_environments:
{{ bootstrap_generate_env_vars_capsule_lifecycle_environments | to_nice_yaml(indent=2) | indent(2, true) }}
capsule_install_sync_wait_time: {{ bootstrap_generate_env_vars_capsule_sync_wait_time | default(86400) | int }}
capsule_install_setup_insights: {{ bootstrap_generate_env_vars_capsule_setup_insights | default(false) | bool | lower }}
capsule_install_selinux_state: "{{ bootstrap_generate_env_vars_capsule_selinux_state | default('enforcing', true) }}"
capsule_install_scenario: "{{ bootstrap_generate_env_vars_capsule_scenario | default('capsule', true) }}"
capsule_install_admin_username: "{{ bootstrap_generate_env_vars_capsule_admin_username | default('admin', true) }}"
capsule_install_satellite_haproxy: {{ bootstrap_generate_env_vars_capsule_satellite_haproxy | default(false) | bool | lower }}
capsule_install_loadbalancer_fqdn: "{{ bootstrap_generate_env_vars_capsule_loadbalancer_fqdn | default('', true) }}"
capsule_install_loadbalancer_activation_key: "{% raw %}{{ vault_capsule_loadbalancer_activation_key | default(omit) }}{% endraw %}"
capsule_install_activation_key: "{% raw %}{{ vault_capsule_activation_key | default(omit) }}{% endraw %}"
capsule_hostname: "{{ bootstrap_generate_env_vars_capsule_hostname | default('', true) }}"
# Client host registration (infra.ado.rhel_sat_reg)
satellite_activation_key: "{{ bootstrap_generate_env_vars_satellite_activation_key | default('') }}"
rhel_sat_reg_satellite_host: "{{ bootstrap_generate_env_vars_satellite_server_url | default('') }}"
rhel_sat_reg_satellite_org_name: "{{ bootstrap_generate_env_vars_satellite_organization | default('') }}"
{% if bootstrap_generate_env_vars_satellite_service_account_username is defined %}
rhel_sat_reg_org_admin_account: "{{ bootstrap_generate_env_vars_satellite_service_account_username }}"
{% else %}
rhel_sat_reg_org_admin_account: "{% raw %}{{ vault_satellite_service_account_username | default('admin') }}{% endraw %}"
{% endif %}
rhel_sat_reg_org_admin_account_password: "{% raw %}{{ vault_satellite_service_account_password | default(vault_satellite_admin_password | default(omit)) }}{% endraw %}"
rhel_sat_reg_activation_key_name: "{{ bootstrap_generate_env_vars_satellite_activation_key | default('') }}"
rhel_sat_reg_validate_certs: {{ bootstrap_generate_env_vars_satellite_validate_certs | default(false) | bool | lower }}
rhel_sat_reg_insecure: {{ (not (bootstrap_generate_env_vars_satellite_validate_certs | default(false) | bool)) | bool | lower }}
satellite_oidc_client_id: "{{ bootstrap_generate_env_vars_satellite_oidc_client_id | default('ado-satellite') }}"
satellite_oidc_realm: "{{ bootstrap_generate_env_vars_satellite_oidc_realm | default('rhlab') }}"
satellite_oidc_keycloak_url: "{{ bootstrap_generate_env_vars_satellite_oidc_keycloak_url | default('') }}"
satellite_oidc_keycloak_hostname: "{{ bootstrap_generate_env_vars_satellite_oidc_keycloak_hostname | default('') }}"
satellite_oidc_issuer: "{{ bootstrap_generate_env_vars_satellite_oidc_issuer | default('') }}"
satellite_oidc_create_client: {{ bootstrap_generate_env_vars_satellite_oidc_create_client | default(true) | bool | lower }}
satellite_oidc_server_url: "{{ bootstrap_generate_env_vars_satellite_server_url | default('') }}"
satellite_oidc_validate_certs: {{ bootstrap_generate_env_vars_satellite_validate_certs | default(false) | bool | lower }}
satellite_oidc_keycloak_validate_certs: {{ bootstrap_generate_env_vars_satellite_oidc_keycloak_validate_certs | default(false) | bool | lower }}
rhbk_hostname: "{{ bootstrap_generate_env_vars_satellite_oidc_keycloak_hostname | default('') }}"
rhbk_realm: "{{ bootstrap_generate_env_vars_satellite_oidc_realm | default('rhlab') }}"
rhbk_client: "{{ bootstrap_generate_env_vars_satellite_oidc_client_id | default('ado-satellite') }}"
rhbk_verify_ssl: {{ bootstrap_generate_env_vars_satellite_oidc_keycloak_validate_certs | default(false) | bool | lower }}

{% elif component_name == 'eck' %}
components_env:
  eck:
    operator_starting_csv: "elasticsearch-eck-operator-certified.v3.0.0"

{% elif component_name == 'quay' %}
components_env:
  quay:
    storage: synology-nfs-csi

{% elif component_name == 'openshift' %}
ocp_cert_manager_mode: cert
ocp_awspca_namespace: cert-manager
ocp_awspca_secret_name: awspca-creds
ocp_awspca_issuer_name: awspca-clusterissuer
ocp_awspca_region: us-gov-west-1
ocp_awspca_pca_arn: ""
idm:
  acme_directory_url: ""
  ca_bundle_file: ""

