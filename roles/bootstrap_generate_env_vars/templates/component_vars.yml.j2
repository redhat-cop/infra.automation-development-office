          - "https://quay.{{ '{{ app_domain }}' }}/oauth2/keycloak/callback/cli"
        rhbk_web_origins:
          - "https://quay.{{ '{{ app_domain }}' }}"
      rhdh_client:
        client_id: rhdh
        rhbk_client_name: "Developer Hub"
