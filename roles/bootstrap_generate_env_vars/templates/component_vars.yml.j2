provision_openshift_virt_prefix_length: {{ openshift_virt_config.prefix_length | default(bootstrap_generate_env_vars_openshift_virt_prefix_length | default(24, true), true) | int }}
provision_openshift_virt_gateway: {{ openshift_virt_config.gateway | default(bootstrap_generate_env_vars_openshift_virt_gateway | default('', true), true) | to_json }}
