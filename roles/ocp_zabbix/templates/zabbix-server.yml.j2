{% set zabbix_pg = (ocp_zabbix_use_postgres | default(true) | bool) %}
{% set zabbix_pg_secret = zabbix_postgres_name | default('zabbix-postgres') %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: zabbix-server
  namespace: {{ name_space }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: zabbix-server
  template:
    metadata:
      labels:
        app: zabbix-server
    spec:
      containers:
        - name: zabbix-server
          image: {{ ocp_zabbix_server_image | default(zabbix_server_image) }}
          ports:
            - containerPort: 10051
          env:
            - name: DB_SERVER_HOST
              value: {{ ocp_zabbix_db_host }}
{% if zabbix_pg %}
            - name: POSTGRES_DB
              valueFrom:
                secretKeyRef:
                  name: {{ zabbix_pg_secret }}
                  key: POSTGRESQL_DATABASE
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: {{ zabbix_pg_secret }}
                  key: POSTGRESQL_USER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ zabbix_pg_secret }}
                  key: POSTGRESQL_PASSWORD
{% else %}
            - name: MYSQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-database
            - name: MYSQL_USER
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-user
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: zabbix-mariadb-secret
                  key: mariadb-password
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: zabbix-server
  namespace: {{ name_space }}
spec:
  selector:
    app: zabbix-server
  ports:
    - port: 10051
      targetPort: 10051
